---
import { TITLE } from '@/utils/data';

const items = Array.from({ length: 20 }, (_, i) => 20 - i);
---

{items.map(index => <h2 style={`--index: ${index};`}>{TITLE}</h2>)}

<script>
  import { $ } from '@/utils/functions';
import gsap from 'gsap';
  const $hero = $('.am-hero');

  $hero.addEventListener('pointermove', ({ x, y }) => {
    gsap.set('h2', {
      '--x': gsap.utils.mapRange(0, window.innerWidth, -10, 10, x),
      '--y': gsap.utils.mapRange(0, window.innerHeight, -10, 10, y)
    });
  });
</script>

<style is:global>
  @font-face {
    font-family: 'Open Sans';
    font-style: normal;
    font-weight: 800;
    font-stretch: 100%;
    font-display: swap;
    src: url('/assets/open-sans.woff2') format('woff2');
  }

  .am-hero h2 {
    font-family: 'Open Sans', sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell,
      'Helvetica Neue';
  }

  @property --hue {
    inherits: false;
    initial-value: 0;
    syntax: '<number>';
  }

  :root {
    --stroke: hsl(0, 0%, 10%);
  }

  * {
    box-sizing: border-box;
  }

  h2 {
    --color: hsl(var(--hue), 80%, 60%);
    text-transform: uppercase;
    letter-spacing: 0.25vmin;
    position: absolute;
    margin: 0;
    text-align: center;
    top: 50%;
    left: 50%;
    line-height: 0.8;
    color: var(--color);
    width: 50%;
    font-size: 7vmax;
    transform: translate(-30%, -70%)
      translate(
        calc(var(--index) * (var(--x, -4) * 1%)),
        calc(var(--index) * (var(--y, 20) * 1%))
      );
    -webkit-text-stroke: 1vmin var(--stroke);
    animation: party 1s calc(var(--index) * -0.1s) infinite linear;

    @media (width <= 1111px) and (orientation: portrait) {
      width: 60%;
      font-size: 4.4vmax;
    }
  }

  @keyframes party {
    100% {
      --hue: 360;
    }
  }
</style>
