---
import { AUTHOR, INKSCAPE_URL } from '@/utils/data';

const year = new Date().getFullYear();
---

<footer
  class="border-t border-border/70 bg-muted/40"
>
  <div
    class="mx-auto flex w-full max-w-[110rem] flex-col gap-6 px-5 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p class="text-sm text-muted-foreground">
      <span class="text-foreground">{AUTHOR}</span>
      · Every artwork drawn with
      <a
        class="underline underline-offset-4 transition-colors hover:text-foreground"
        href={INKSCAPE_URL}
        rel="noopener noreferrer"
        target="_blank">Inkscape</a
      >.
    </p>

    <p class="font-mono text-xs tracking-[0.18em] text-muted-foreground/70 uppercase">
      © {year}
    </p>
  </div>
</footer>
