---
import { baseUrl } from '@/utils/functions';
import Title from './title.astro';
const logo = baseUrl('/assets/inkscape-logo-noise.avif');
---

<section class='am-hero'>
  <a href='https://inkscape.org/'><img src={logo} alt='Logo' class='logo' /></a>
  <Title />
</section>

<style>
  .am-hero {
    height: 100vh;
    position: relative;
    overflow: hidden;
    background: var(--bg);
    font-family: 'Open Sans', sans-serif;
    touch-action: pan-y;
    cursor: pointer;
  }

  img.logo {
    position: absolute;
    right: 1.5vmax;
    bottom: 1.5vmax;
    width: 6vmax;
    object-fit: cover;
    border-radius: 50%;
    z-index: 10000;
  }
</style>
